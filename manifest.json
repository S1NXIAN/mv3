{
  "manifest_version": 3,
  "name": "MV3",
  "version": "1.1.0",
  "description": "Intercept HLS streams and send them to MPV player via Native Messaging. Detects Master Playlists for quality selection.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle/icon16.png",
      "48": "icons/idle/icon48.png",
      "128": "icons/idle/icon128.png"
    },
    "default_title": "MPV Bridge"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/idle/icon16.png",
    "48": "icons/idle/icon48.png",
    "128": "icons/idle/icon128.png"
  }
}
